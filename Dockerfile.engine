FROM node:22-alpine

WORKDIR /usr/src/app

# curl = healthchecks; build toolchain = better-sqlite3 (native)
RUN apk add --no-cache curl python3 make g++

COPY package*.json ./
RUN npm ci --omit=dev \
  && apk del python3 make g++

COPY . .

ENV NODE_ENV=production
ENV ENGINE_MODE=shadow
ENV ENGINE_PORT=3201
ENV ENGINE_HOST=0.0.0.0
ENV ENGINE_SNAPSHOT_SOURCE=fixture

EXPOSE 3201

# Processo da engine — separado da UI (Dockerfile → sirv :3200)
CMD ["node", "scripts/engine-serve.js"]
