PORT=3200
HOST=0.0.0.0

# Dashboard público faz proxy somente para a engine interna.
ENGINE_INTERNAL_URL=http://data-robot-engine:3201
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# ── Polymarket CLOB (trading real) ─────────────────────────────
POLYMARKET_PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_AQUI

# Credenciais L2 — use: npm run derive-key:write
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# 0=EOA, 1=POLY_PROXY (email/Magic), 2=GNOSIS_SAFE, 3=POLY_1271 (deposit wallet)
POLYMARKET_SIGNATURE_TYPE=1

# Endereço do perfil (proxyWallet) — polymarket.com/settings
POLYMARKET_FUNDER_ADDRESS=

POLYMARKET_DERIVE_NONCE_MAX=50

# ── Engine/control plane ───────────────────────────────────────
ENGINE_MODE=shadow
ENGINE_LIVE_ENABLED=0
ENGINE_HOST=0.0.0.0
ENGINE_PORT=3201
ENGINE_OPS_TOKEN=troque-por-token-longo-e-aleatorio
ENGINE_CHECKPOINT_MS=30000
# Retenção em disco (volume /data): checkpoints timestamped, dumps journal, audit JSONL.
ENGINE_CHECKPOINT_KEEP=3
ENGINE_JOURNAL_KEEP=3
ENGINE_AUDIT_KEEP_DAYS=3
# Heartbeat CLOB: blip cancela resting; HALT só se falhar por este tempo (ms).
ENGINE_CLOB_HEARTBEAT_MS=5000
ENGINE_CLOB_HEARTBEAT_HALT_MS=60000
ENGINE_USER_DISCONNECT_HALT_MS=60000
ENGINE_STATE_DIR=runs
# active-strategy + custom presets (default = $ENGINE_STATE_DIR/strategy-config, volume persistente)
# STRATEGY_CONFIG_DIR=runs/strategy-config
ENGINE_CANARY_MODE=0
ENGINE_CANARY_MAX_BUDGET=4
# Exposição agregada portfolio (4 ativos × $4). Default no código = 16.
ENGINE_MAX_ACCOUNT_EXPOSURE=16
ENGINE_CONTROL_WINDOW_MS=86400000
ENGINE_STRATEGY_ID=fixture-price-cross
ENGINE_STRATEGY_INSTANCE_ID=fixture-price-cross:primary
STRATEGY_CATALOG_PATH=config/strategy-catalog.json
# fixture = smoke/soak sem rede; btc5m|eth5m|sol5m|xrp5m = Gamma + RTDS + CLOB
ENGINE_SNAPSHOT_SOURCE=fixture
# Watchdog/fallback; RTDS/CLOB disparam ingest imediatamente.
# idle = longe do slot; hot = pré-entrada (τ≤PRE_ENTRY_SECS) até o fim.
ENGINE_SOURCE_IDLE_INTERVAL_MS=500
ENGINE_SOURCE_HOT_INTERVAL_MS=50
ENGINE_SOURCE_PRE_ENTRY_SECS=45
ENGINE_MARKET_SYNC_MS=15000
ENGINE_SOURCE_RETRY_MS=2000
# Poll Gamma para settlement async (ms). Resolve cedo via outcomePrices 0/1, sem esperar closed.
ENGINE_SETTLEMENT_POLL_MS=1000
